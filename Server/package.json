{
  "name": "office-workspace-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.{mjs,ts}\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.{mjs,ts}\"",
    "db:init": "node scripts/init-local.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:clean": "node scripts/reset-local.mjs",
    "db:studio": "prisma studio --hostname 127.0.0.1 --port 5556",
    "db:check": "tsx scripts/check-seed.ts",
    "auth:check": "tsx scripts/check-auth.ts",
    "tasks:check": "tsx scripts/check-tasks.ts",
    "workflow:check": "tsx scripts/check-workflow.ts",
    "notifications:check": "tsx scripts/check-notifications.ts",
    "files:cleanup": "tsx scripts/cleanup-files.ts",
    "files:check": "tsx scripts/check-files.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.2.8",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "file-type": "21.3.4",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@nestjs/cli": "11.0.10",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/node": "24.0.15",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.12"
  }
}
