# Copy with npm run db:init. Values below are keys/documentation, not credentials.
APP_ENV=local
PORT=3000
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
# Fixed-clock acceptance only; Config validation rejects this outside local.
SYSTEM_CLOCK_OVERRIDE=
DATABASE_URL=
LOCAL_POSTGRES_USER=office_workspace
LOCAL_POSTGRES_DB=office_workspace
LOCAL_POSTGRES_PASSWORD=
FRONTEND_ORIGINS=http://localhost:5173
ACCESS_TOKEN_SIGNING_KEY=
DEMO_SEED_PASSWORD=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_HTTP_ONLY=true
REFRESH_COOKIE_SAME_SITE=Lax
LOGIN_RATE_LIMIT_PER_MINUTE=5
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILE_BUCKET=
R2_ENDPOINT=
R2_SIGNED_URL_TTL_SECONDS=300
MAX_FILE_SIZE_MB=20
FILE_REMOVED_RETENTION_DAYS=90
FILE_CLEANUP_BATCH_SIZE=100
REMINDER_INTERVAL_MINUTES=15
REMINDER_BEFORE_HOURS=24
BACKUP_BUCKET=
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_LOCAL_DIR=
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_UTC=02:00
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
PSQL_BIN=psql
PG_CLIENT_DOCKER_CONTAINER=
RESTORE_DRILL_DATABASE_URL=
REAL_DATA_APPROVED=false
